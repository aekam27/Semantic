# Copy to .env and fill in. Never commit the real file.

# Required. HMAC signing key for issued tokens; must be at least 32 bytes.
# Generate one with: openssl rand -base64 48
JWT_SECRET=

# Required. Full MongoDB connection string, including credentials.
MONGODB_URI=mongodb+srv://user:password@cluster.example.mongodb.net/?retryWrites=true&w=majority

# Optional, defaults shown.
ADDR=:8001
MONGODB_DATABASE=semantic
MONGODB_COLLECTION=vectormap
REDIS_ADDR=localhost:6379
EMBEDDING_SERVICE_URL=http://localhost:8000/v1/vectorEmbeddings/

# Accepts a duration ("15m") or a bare number of seconds ("900").
TOKEN_TTL=15m
REQUEST_TIMEOUT=30s
